# ─────────────────────────────────────────────────────────────
# SIWES Hunter NG — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to GitHub!
# ─────────────────────────────────────────────────────────────

# REQUIRED
TELEGRAM_BOT_TOKEN=paste_your_new_token_from_botfather_here
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_ID=your_personal_telegram_user_id

# OPTIONAL (safe defaults below)
MAX_ALERTS_PER_RUN=8
MIN_RANK_SCORE=30
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Africa/Lagos
